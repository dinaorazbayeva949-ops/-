# Скопируйте этот файл в .env для локального теста (в GitHub Actions эти же
# значения задаются через Secrets/Variables — см. README.md).

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-mailbox@gmail.com
SMTP_PASSWORD=app-password-here

SENDER_NAME=Коллектив компании

MILESTONE_START=50
MILESTONE_STEP=5
REMINDER_DAYS_BEFORE=0

DATA_FILE=data/employees.xlsx
SENT_LOG_FILE=data/sent_log.csv
